# Chain
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Deployed Cadence contracts — from Phase 1's Deploy.s.sol +
# ConfigureAgent.s.sol output
AGENT_ACCOUNT=
AGENT_FACTORY=
POLICY_MODULE=
LENDING_POOL=
PRICE_ORACLE=
COLLATERAL_TOKEN=
DEBT_TOKEN=

# Agent's hot signing key. Bounded entirely by PolicyModule on-chain —
# see Cadence-contracts' README for why compromising this key alone
# cannot move funds outside the allowlisted actions. Never reuse the
# owner/admin key here.
AGENT_SIGNER_PRIVATE_KEY=
# Required for automatic per-wallet AgentAccount provisioning. Keep server-side.
ADMIN_PRIVATE_KEY=

# SUBMISSION_MODE=relayer submits directly via EntryPoint.handleOps using
# a funded relayer key — not gasless, but exercises the same on-chain
# validation + policy path a real bundler would, useful before Arc's
# bundler endpoint is confirmed. SUBMISSION_MODE=bundler uses a real
# ERC-4337 bundler RPC (the production path once confirmed).
SUBMISSION_MODE=relayer
RELAYER_PRIVATE_KEY=
BUNDLER_RPC_URL=

# LLM provider — Groq is the default (free tier, fast, tool-calling).
# Cerebras is the documented fallback if Groq's rate limits are hit
# mid-run (see README).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Loop behavior
MAX_REASONING_ROUNDS=6
POLL_INTERVAL_SECONDS=900
PORT=8787
# Required in production to protect agent control endpoints.
AGENT_API_KEY=generate-a-long-random-secret
# Optional: HTTPS endpoint for error alerts (Slack/Discord/custom webhook).
ALERT_WEBHOOK_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
