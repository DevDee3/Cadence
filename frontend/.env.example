# Copy to .env.local and fill in with addresses from Phase 1's
# Deploy.s.sol + ConfigureAgent.s.sol output (Arc Testnet).

NEXT_PUBLIC_AGENT_ACCOUNT=
NEXT_PUBLIC_AGENT_FACTORY=
NEXT_PUBLIC_POLICY_MODULE=
NEXT_PUBLIC_LENDING_POOL=
NEXT_PUBLIC_PRICE_ORACLE=
NEXT_PUBLIC_COLLATERAL_TOKEN=
NEXT_PUBLIC_DEBT_TOKEN=
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
AGENT_BACKEND_URL=http://localhost:8787
AGENT_BACKEND_API_KEY=use-the-same-secret-as-backend
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Block Deploy.s.sol was broadcast at — bounds the ActionExecuted log
# scan so the feed doesn't crawl from genesis. Optional; defaults to 0.
NEXT_PUBLIC_DEPLOY_BLOCK=
